#define DEFAULT 0
#define SYM     1
#define FUN     2
#define MOUSE   3
#define SCROLL  4
#define SNIPE   5

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&nice_view_spi { cs-gpios = <&pro_micro 1 GPIO_ACTIVE_HIGH>; };

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWRT";
            bindings = <
&kp ESC         &kp N1    &kp N2  &kp N3  &kp N4  &kp N5                             &kp N6     &kp N7  &kp N8     &kp N9   &kp N0         &kp BSPC
&kp TAB         &kp Q     &kp W   &kp E   &kp R   &kp T                              &kp Y      &kp U   &kp I      &kp O    &kp P          &kp BACKSLASH
&kp CAPS        &kp A     &kp S   &kp D   &kp F   &kp G                              &kp H      &kp J   &kp K      &kp L    &kp SEMI       &kp SQT
&kp LEFT_SHIFT  &kp Z     &kp X   &kp C   &kp V   &kp B   &kp LWIN  &kp PRINTSCREEN  &kp N      &kp M   &kp COMMA  &kp DOT  &kp FSLH       &kp RIGHT_SHIFT
&kp LCTRL       &kp LALT  &to 3   &mo 5   &mo 6   &mo 1   &mo 2     &kp ENTER        &kp SPACE                              &kp RIGHT_ALT  &kp RCTRL
            >;
        };

        function_layer {
            bindings = <
&kp GRAVE  &kp F1  &kp F2    &kp F3    &kp F4     &kp F5                                  &kp F6    &kp F7         &kp F8     &kp F9   &kp F10  &kp DEL
&trans     &none   &none     &kp UP    &none      &none                                   &none     &kp MINUS      &kp EQUAL  &kp F11  &kp F12  &none
&trans     &none   &kp LEFT  &kp DOWN  &kp RIGHT  &kp C_VOL_UP                            &kp HOME  &kp LBKT       &kp RBKT   &none    &none    &none
&trans     &none   &none     &none     &none      &kp C_VOL_DN  &kp K_MUTE  &kp LC(LEFT)  &kp END   &kp LC(RIGHT)  &none      &none    &none    &trans
&trans     &trans  &trans    &trans    &trans     &trans        &trans      &trans        &trans                                       &trans   &trans
            >;

            label = "FUNC";
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&kp TILDE  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                          &none      &none      &none     &none  &none   &kp INS
&trans     &bt BT_CLR    &bt BT_CLR_ALL  &none         &none         &none                                 &none      &kp UNDER  &kp PLUS  &none  &none   &none
&trans     &none         &none           &none         &none         &none                                 &kp PG_UP  &kp LBRC   &kp RBRC  &none  &none   &none
&trans     &none         &none           &none         &none         &none         &studio_unlock  &none   &kp PG_DN  &none      &none     &none  &none   &trans
&trans     &trans        &trans          &trans        &trans        &trans        &trans          &trans  &trans                                 &trans  &trans
            >;
        };

        numpad_layer {
            label = "NUM";
            bindings = <
&none   &none   &none    &none    &none    &none                     &kp KP_NUM  &kp KP_N7  &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE    &kp KP_ASTERISK
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &none                     &none       &kp KP_N4  &kp KP_N5  &kp KP_N6   &kp KP_SUBTRACT  &none
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &none                     &kp UP      &kp KP_N1  &kp KP_N2  &kp KP_N3   &kp KP_PLUS      &none
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &none   &none   &kp LEFT  &kp DOWN    &kp RIGHT  &kp KP_N0  &kp KP_DOT  &kp KP_ENTER     &trans
&trans  &trans  &to 0    &trans   &trans   &trans  &trans  &trans    &trans                                        &trans           &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans  &trans  &trans    &trans    &trans     &trans                  &trans    &trans     &trans  &trans     &trans     &trans
&trans  &trans  &trans    &kp UP    &trans     &trans                  &trans    &trans     &trans  &trans     &trans     &trans
&trans  &trans  &kp DOWN  &kp DOWN  &kp RIGHT  &trans                  &mkp MB5  &mkp LCLK  &mo 5   &mkp RCLK  &mkp MCLK  &trans
&trans  &trans  &trans    &trans    &trans     &trans  &trans  &trans  &mkp MB4  &trans     &mo 6   &trans     &trans     &trans
&trans  &trans  &trans    &trans    &trans     &trans  &trans  &trans  &mo 3                                   &trans     &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans  &trans
            >;
        };
    };
};
